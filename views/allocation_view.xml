<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="equipment_allocations_view_form" model="ir.ui.view">
        <field name="name">equipment.allocations.view.form</field>
        <field name="model">equipment.allocations</field>
        <field name="arch" type="xml">
            <form string="Asignación de equipos">
                <header>
                    <button name="handle_allocated" type="object" string="Asignar"
                        class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="handle_rejected" type="object" string="Rechazar"
                        class="oe_stat_button" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="handle_returned" type="object" string="Devuelto"
                        class="oe_stat_button" attrs="{'invisible': [('state', '!=', 'allocated')]}" />
                    <button name="handle_draft" type="object" string="Restablecer a borrador"
                        class="oe_stat_button"
                        groups="equipment_allocation.group_equipment_allocations_access" />

                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_row">
                            <field name="uid" readonly="1" />
                        </div>
                        <br />
                        <h1 class="o_row">
                            <field name="name" placeholder="Solicitud de equipo"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="allocation_type"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}"
                                widget="radio"
                                options="{'horizontal': true}" />
                            <field name="area"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                            <field name="employee_id" widget="many2one_avatar_employee"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                            <!-- <field name="employee_ids" widget="badge"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" /> -->
                            <field name="has_replacement"
                                attrs="{'invisible': [('has_replacement', '=', False)]}"
                                readonly="1" />
                        </group>
                        <group>
                            <field name="request_date" readonly="1" />
                            <label for="duration" string="Duración"
                                attrs="{'invisible': [('allocation_type', '!=', 'on_demand')]}" />
                            <div attrs="{'invisible': [('allocation_type', '!=', 'on_demand')]}">
                                <field name="duration" class="oe_inline"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'allocated'])], 'required': [('allocation_type', '=', 'on_demand')] }" />
                                <field name="duration_type" class="oe_inline"
                                    attrs="{'readonly': [('state', 'not in', ['draft', 'allocated'])], 'required': [('allocation_type', '=', 'on_demand')] }" />
                            </div>
                            <field name="allocation_date"
                                readonly="1"
                                force_save="1"
                                attrs="{'invisible': [('allocation_date', '=', False)]}" />
                            <field name="return_date"
                                readonly="1"
                                force_save="1"
                                attrs="{'invisible': [('allocation_type', '!=', 'on_demand'), ('return_date', '=', False)]}" />
                            <field name="real_return_date" readonly="1"
                                force_save="1"
                                attrs="{'invisible': [('allocation_type', '!=', 'on_demand'), ('real_return_date', '=', False)]}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos">
                            <field name="equipment_ids"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                        </page>
                        <page string="Equipos Anteriores"
                            attrs="{'invisible': [('has_replacement', '=', False)]}">
                            <field name="before_equipment_ids"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                        </page>
                        <page string="Descripción">
                            <field name="description"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="equipment_allocations_search_view" model="ir.ui.view">
        <field name="name">equipment.allocations.search</field>
        <field name="model">equipment.allocations</field>
        <field name="arch" type="xml">
            <search string="Buscar Asignación de Equipos">
                <field name="name" />
                <field name="employee_id" />
                <field name="area" />
                <field name="allocation_type" />
                <field name="state" />

                <filter name="filter_draft"
                    string="Borradores"
                    domain="[('state','=','draft')]" />
                <filter name="filter_allocated"
                    string="Asignados"
                    domain="[('state','=','allocated')]" />
                <filter name="filter_rejected"
                    string="rechazados"
                    domain="[('state','=','rejected')]" />
                <filter name="filter_returned"
                    string="Devueltos"
                    domain="[('state','=','returned')]" />

                <group
                    expand="0"
                    string="Agrupar por">
                    <filter name="state"
                        string="Estado"
                        domain="[]"
                        context="{'group_by': 'state'}" />
                    <filter name="allocation_type"
                        string="Tipo de Asignación"
                        domain="[]"
                        context="{'group_by': 'allocation_type'}" />
                    <filter name="employee_id"
                        string="Empleado"
                        domain="[]"
                        context="{'group_by': 'employee_id'}" />
                    <filter name="area"
                        string="Área"
                        domain="[]"
                        context="{'group_by': 'area'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="equipment_allocations_view_tree" model="ir.ui.view">
        <field name="name">equipment.allocations.view.tree</field>
        <field name="model">equipment.allocations</field>
        <field name="arch" type="xml">
            <tree string="Asignación de equipos">
                <field name="uid" width="100" />
                <field name="name" />
                <field name="allocation_type" width="200" />
                <field name="create_date" string="Fecha de creación" width="200" />
                <field name="request_date" width="200" />
                <field name="real_return_date" width="200" />
                <field name="area" width="200" />
                <field name="state" width="200" />
            </tree>
        </field>
    </record>

    <record id="equipment_allocations_action" model="ir.actions.act_window">
        <field name="name">Asignación de equipos</field>
        <field name="res_model">equipment.allocations</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Desde aquí puedes gestionar tus asignaciones.
            </p>
        </field>
    </record>

    <menuitem
        id="equipment_allocations_sub_menu"
        name="Solicitud de asignacion de equipos"
        action="equipment_allocations_action"
        parent="equipment_allocation.equipment_allocations_menu"
        sequence="10" />
</odoo>