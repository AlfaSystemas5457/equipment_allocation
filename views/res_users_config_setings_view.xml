<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="equipment_allocartions_access_right" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]" position="before">
                <group string="Acceso a Asignaciones de Equipos" class="text-nowrap">
                    <field name="access_scope_equipment" widget="boolean_toggle" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>