<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="equipment_replacement_view_form"
        model="ir.ui.view">
        <field name="name">equipment.replacement.view.form</field>
        <field name="model">equipment.replacement</field>
        <field name="arch"
            type="xml">
            <form delete="false"
                duplicate="false">
                <header>
                    <button name="handle_allocated"
                        type="object"
                        string="Asignar"
                        class="oe_highlight "
                        invisible="state != 'draft'" />
                    <button name="handle_rejected"
                        type="object"
                        string="Rechazar"
                        class="oe_stat_button"
                        invisible="state != 'draft'" />
                    <button name="handle_draft"
                        type="object"
                        string="Restablecer a borrador"
                        class="oe_stat_button"
                        groups="equipment_allocation.group_equipment_replacement_access" />

                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="draft,allocated,returned" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_row">
                            <field name="uid"
                                readonly="1" />
                        </div>
                        <h1 class="o_row">
                            <field name="uid_replacement"
                                placeholder="Reemplazo de equipo"
                                readonly="state not in ['draft']" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="area"
                                readonly="1" />
                            <field name="employee_id"
                                widget="many2one_avatar_employee"
                                readonly="1" />
                        </group>
                        <group>
                            <field name="request_date"
                                readonly="1" />
                            <field name="allocation_type"
                                readonly="1"
                                widget="radio"
                                options="{'horizontal': true}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos">
                            <field name="equipment_ids"
                                readonly="state not in ['draft']">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="serial_no" />
                                    <field name="technician_user_id" />
                                    <field name="category_id" />
                                    <field name="company_id" />
                                </list>
                            </field>
                        </page>
                        <page string="Descripción">
                            <field name="description"
                                readonly="state not in ['draft']" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="equipment_replacement_view_list"
        model="ir.ui.view">
        <field name="name">equipment.replacement.view.list</field>
        <field name="model">equipment.replacement</field>
        <field name="arch"
            type="xml">
            <list delete="false"
                duplicate="false">
                <field name="uid"
                    width="100"
                    decoration-bf="1" />
                <field name="employee_id" />
                <field name="create_date"
                    string="Fecha de creación"
                    width="200" />
                <field name="request_date"
                    width="200" />
                <field name="area"
                    width="200" />
                <field name="state"
                    width="200" />
            </list>
        </field>
    </record>

    <record id="equipment_replacement_search_view"
        model="ir.ui.view">
        <field name="name">equipment.replacement.search</field>
        <field name="model">equipment.replacement</field>
        <field name="arch"
            type="xml">
            <search string="Buscar Reemplazo de Equipos">
                <field name="employee_id" />
                <field name="area" />
                <field name="allocation_type" />
                <field name="state" />

                <filter name="filter_draft"
                    string="Borradores"
                    domain="[('state','=','draft')]" />
                <filter name="filter_allocated"
                    string="Asignados"
                    domain="[('state','=','allocated')]" />
                <filter name="filter_rejected"
                    string="Rechazados"
                    domain="[('state','=','rejected')]" />
                <filter name="filter_returned"
                    string="Devueltos"
                    domain="[('state','=','returned')]" />

                <group>
                    <filter name="state"
                        string="Estado"
                        domain="[]"
                        context="{'group_by': 'state'}" />
                    <filter name="allocation_type"
                        string="Tipo de Asignación"
                        domain="[]"
                        context="{'group_by': 'allocation_type'}" />
                    <separator/>
                    <filter name="employee_id"
                        string="Empleado"
                        domain="[]"
                        context="{'group_by': 'employee_id'}" />
                    <filter name="area"
                        string="Área"
                        domain="[]"
                        context="{'group_by': 'area'}" />
                </group>
            </search>
        </field>
    </record>


    <record id="equipment_replacement_action"
        model="ir.actions.act_window">
        <field name="name">Reemplazo de equipos</field>
        <field name="res_model">equipment.replacement</field>
        <field name="view_mode">list,form</field>
        <field name="help"
            type="html">
            <p class="o_view_nocontent_smiling_face">
                Desde aquí puedes gestionar tus reemplazos.
            </p>
        </field>
    </record>

    <menuitem id="equipment_replacement_sub_menu"
        name="Solicitud de reemplazo de equipos"
        action="equipment_replacement_action"
        parent="equipment_allocations_menu"
        sequence="20" />
</odoo>