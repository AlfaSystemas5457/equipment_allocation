<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="equipment_replacement_view_form" model="ir.ui.view">
        <field name="name">equipment.replacement.view.form</field>
        <field name="model">equipment.replacement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="handle_allocated" type="object" string="Asignar"
                        class="bg-primary text-light " invisible="state != 'draft'" />
                    <button name="handle_rejected" type="object" string="Rechazar"
                        class="bg-secondary text-dark" invisible="state != 'draft'" />
                    <button name="handle_draft" type="object" string="Borrador"
                        class="bg-secondary text-dark" />

                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_row">
                            <field name="uid" readonly="1" />
                        </div>
                        <h1 class="o_row">
                            <field name="uid_replacement" placeholder="Reemplazo de equipo"
                                readonly="state not in ['draft']" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="area" readonly="1" />
                            <field name="employee_ids" widget="many2many_tags" readonly="1" />
                        </group>
                        <group>
                            <field name="request_date" readonly="1" />
                            <field name="allocation_type"
                                readonly="1" widget="radio"
                                options="{'horizontal': true}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos">
                            <field name="equipment_ids" readonly="state not in ['draft']" />
                        </page>
                        <page string="Descripción">
                            <field name="description" readonly="state not in ['draft']" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="equipment_replacement_view_list" model="ir.ui.view">
        <field name="name">equipment.replacement.view.list</field>
        <field name="model">equipment.replacement</field>
        <field name="arch" type="xml">
            <list>
                <field name="uid" />
                <field name="name" />
                <field name="create_date" string="Fecha de creación" />
                <field name="request_date" />
                <field name="area" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="equipment_replacement_action" model="ir.actions.act_window">
        <field name="name">Reemplazo de equipos</field>
        <field name="res_model">equipment.replacement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Desde aquí puedes gestionar tus reemplazos.
            </p>
        </field>
    </record>

    <menuitem
        id="equipment_replacement_sub_menu"
        name="Solicitud de reemplazo de equipos"
        action="equipment_replacement_action"
        parent="equipment_allocations_menu"
        sequence="20" />
</odoo>