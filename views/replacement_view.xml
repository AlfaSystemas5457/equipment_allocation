<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="equipment_replacement_view_form" model="ir.ui.view">
        <field name="name">equipment.replacement.view.form</field>
        <field name="model">equipment.replacement</field>
        <field name="arch" type="xml">
            <form string="Reemplazo de equipo">
                <header>
                    <button name="handle_allocated" type="object" string="Asignar"
                        class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="handle_rejected" type="object" string="Rechazar"
                        class="oe_stat_button" attrs="{'invisible': [('state', '!=', 'draft')]}" />
                    <button name="handle_draft" type="object" string="Restablecer a borrador"
                        class="oe_stat_button"
                        groups="equipment_allocation.group_equipment_replacement_access" />

                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_row">
                            <field name="uid" readonly="1" />
                        </div>
                        <br />
                        <h1 class="o_row">
                            <field name="uid_replacement" placeholder="Reemplazo de equipo"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="area" readonly="1" />
                            <field name="employee_id" widget="many2one_avatar_employee" readonly="1" />
                        </group>
                        <group>
                            <field name="request_date" readonly="1" />
                            <field name="allocation_type"
                                readonly="1" widget="radio"
                                options="{'horizontal': true}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos">
                            <field name="equipment_ids"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                        </page>
                        <page string="Descripción">
                            <field name="description"
                                attrs="{'readonly': [('state', 'not in', ['draft'])]}" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="equipment_replacement_view_tree" model="ir.ui.view">
        <field name="name">equipment.replacement.view.tree</field>
        <field name="model">equipment.replacement</field>
        <field name="arch" type="xml">
            <tree string="Reemplazo de equipos">
                <field name="uid" width="100" />
                <field name="name" />
                <field name="create_date" string="Fecha de creación" width="200" />
                <field name="request_date" width="200" />
                <field name="area" width="200" />
                <field name="state" width="200" />
            </tree>
        </field>
    </record>

    <record id="equipment_allocations_search_view" model="ir.ui.view">
        <field name="name">equipment.allocations.search</field>
        <field name="model">equipment.allocations</field>
        <field name="arch" type="xml">
            <search string="Buscar Asignación de Equipos">
                <field name="name" />
                <field name="employee_id" />
                <field name="area" />
                <field name="allocation_type" />
                <field name="state" />

                <filter name="filter_draft"
                    string="Borradores"
                    domain="[('state','=','draft')]" />
                <filter name="filter_allocated"
                    string="Asignados"
                    domain="[('state','=','allocated')]" />
                <filter name="filter_rejected"
                    string="rechazados"
                    domain="[('state','=','rejected')]" />
                <filter name="filter_returned"
                    string="Devueltos"
                    domain="[('state','=','returned')]" />

                <group
                    expand="0"
                    string="Agrupar por">
                    <filter name="state"
                        string="Estado"
                        domain="[]"
                        context="{'group_by': 'state'}" />
                    <filter name="allocation_type"
                        string="Tipo de Asignación"
                        domain="[]"
                        context="{'group_by': 'allocation_type'}" />
                    <filter name="employee_id"
                        string="Empleado"
                        domain="[]"
                        context="{'group_by': 'employee_id'}" />
                    <filter name="area"
                        string="Área"
                        domain="[]"
                        context="{'group_by': 'area'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="equipment_replacement_action" model="ir.actions.act_window">
        <field name="name">Reemplazo de equipos</field>
        <field name="res_model">equipment.replacement</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Desde aquí puedes gestionar tus reemplazos.
            </p>
        </field>
    </record>

    <menuitem
        id="equipment_replacement_sub_menu"
        name="Solicitud de reemplazo de equipos"
        action="equipment_replacement_action"
        parent="equipment_allocations_menu"
        sequence="20" />
</odoo>