<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_equipment_settings_form" model="ir.ui.view">
        <field name="name">equipment.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Mantenimiento" string="Mantenimiento"
                    data-key="maintenance">
                    <h2>Recordatorios de devolución</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_return_emails" />
                            </div>
                            <div class="o_setting_right_pane" id="maintenance_settings">
                                <label for="enable_return_emails" />
                                <div class="text-muted">
                                    Si está activado, se enviarán correos automáticos a los
                                    empleados antes de la fecha de devolución de los equipos
                                    asignados.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <data noupdate="1">
        <function model="ir.config_parameter" name="set_param">
            <value eval="'equipment_allocation.enable_return_emails'" />
            <value eval="'True'" />
        </function>
    </data>
</odoo>