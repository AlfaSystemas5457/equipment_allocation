<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_equipment_form_inherit_empleados" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.empleados</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="employee_ids" widget="many2many_tags" string="Empleados" />
            </xpath>
        </field>
    </record>

</odoo>