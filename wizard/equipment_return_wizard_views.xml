<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_equipment_return_wizard_form" model="ir.ui.view">
        <field name="name">equipment.return.wizard.form</field>
        <field name="model">equipment.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Devolución de Equipo">
                <group>
                    <h1>
                        <field name="allocation_id" readonly="1" />
                    </h1>
                </group>
                <group>
                    <div>
                        <h2>
                            <label for="return_description" />
                        </h2>
                        <field name="return_description" />
                    </div>
                </group>
                <footer>
                    <button name="confirm_return"
                        string="Confirmar e Imprimir"
                        type="object"
                        class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>